<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <div class="row">

        <div class="col-8 offset-2">

            <h1 class="mb-4">
                Edit Listing
            </h1>


            <form
                method="POST"
                action="/listings/<%= listing._id %>?_method=PUT"
                enctype="multipart/form-data"
            >


                <!-- TITLE -->

                <div class="mb-3">

                    <label class="form-label">
                        Title
                    </label>

                    <input
                        name="listing[title]"
                        type="text"
                        value="<%= listing.title %>"
                        class="form-control"
                        required
                    >

                </div>


                <!-- DESCRIPTION -->

                <div class="mb-3">

                    <label class="form-label">
                        Description
                    </label>

                    <textarea
                        name="listing[description]"
                        class="form-control"
                        rows="5"
                        required
                    ><%= listing.description %></textarea>

                </div>


                <!-- CURRENT IMAGE -->

                <% if (listing.image && listing.image.url) { %>

                    <div class="mb-3">

                        <label class="form-label">
                            Current Image
                        </label>

                        <br>

                        <img
                            src="<%= listing.image.url %>"
                            alt="<%= listing.title %>"
                            style="
                                width: 300px;
                                height: 180px;
                                object-fit: cover;
                                border-radius: 12px;
                            "
                        >

                    </div>

                <% } %>


                <!-- NEW IMAGE -->

                <div class="mb-3">

                    <label class="form-label">
                        Upload New Image
                    </label>

                    <input
                        name="listing[image]"
                        type="file"
                        accept="image/*"
                        class="form-control"
                    >

                    <small class="text-muted">
                        Leave empty to keep the current image.
                    </small>

                </div>


                <!-- CATEGORY -->

                <div class="mb-3">

                    <label class="form-label">
                        Category
                    </label>


                    <select
                        name="listing[category]"
                        class="form-control"
                        required
                    >

                        <% const categories = [
                            "Rooms",
                            "Villas",
                            "Amazing Views",
                            "Iconic Cities",
                            "Surfing",
                            "Amazing Pools",
                            "Beach",
                            "Cabins",
                            "Mountains",
                            "Farms",
                            "Lakefront",
                            "Trending"
                        ]; %>


                        <% for (let category of categories) { %>

                            <option
                                value="<%= category %>"
                                <%= listing.category === category
                                    ? "selected"
                                    : ""
                                %>
                            >
                                <%= category %>
                            </option>

                        <% } %>

                    </select>

                </div>


                <!-- PRICE -->

                <div class="mb-3">

                    <label class="form-label">
                        Price / Night
                    </label>

                    <input
                        name="listing[price]"
                        type="number"
                        min="0"
                        value="<%= listing.price %>"
                        class="form-control"
                        required
                    >

                </div>


                <!-- LOCATION -->

                <div class="mb-3">

                    <label class="form-label">
                        Location
                    </label>

                    <input
                        name="listing[location]"
                        type="text"
                        value="<%= listing.location %>"
                        class="form-control"
                        required
                    >

                </div>


                <!-- COUNTRY -->

                <div class="mb-3">

                    <label class="form-label">
                        Country
                    </label>

                    <input
                        name="listing[country]"
                        type="text"
                        value="<%= listing.country %>"
                        class="form-control"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn btn-danger px-4"
                >
                    Update Listing
                </button>


            </form>

        </div>

    </div>

</div>
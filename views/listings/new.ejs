<% layout("layouts/boilerplate") %>

<div class="container mt-5">

    <div class="row">

        <div class="col-8 offset-2">

            <h1 class="mb-4">
                Create a New Listing
            </h1>


            <form
                method="POST"
                action="/listings"
                enctype="multipart/form-data"
                class="needs-validation"
                novalidate
            >


                <!-- TITLE -->

                <div class="mb-3">

                    <label
                        for="title"
                        class="form-label"
                    >
                        Title
                    </label>

                    <input
                        name="listing[title]"
                        id="title"
                        type="text"
                        class="form-control"
                        placeholder="Enter listing title"
                        required
                    >

                </div>


                <!-- DESCRIPTION -->

                <div class="mb-3">

                    <label
                        for="description"
                        class="form-label"
                    >
                        Description
                    </label>

                    <textarea
                        name="listing[description]"
                        id="description"
                        class="form-control"
                        rows="5"
                        placeholder="Describe your property"
                        required
                    ></textarea>

                </div>


                <!-- IMAGE -->

                <div class="mb-3">

                    <label
                        for="image"
                        class="form-label"
                    >
                        Property Image
                    </label>

                    <input
                        name="listing[image]"
                        id="image"
                        type="file"
                        class="form-control"
                        accept="image/*"
                        required
                    >

                </div>


                <!-- CATEGORY -->

                <div class="mb-3">

                    <label
                        for="category"
                        class="form-label"
                    >
                        Category
                    </label>


                    <select
                        name="listing[category]"
                        id="category"
                        class="form-control"
                        required
                    >

                        <option value="">
                            Select Category
                        </option>

                        <option value="Rooms">
                            🛏️ Rooms
                        </option>

                        <option value="Villas">
                            🏡 Villas
                        </option>

                        <option value="Amazing Views">
                            🌅 Amazing Views
                        </option>

                        <option value="Iconic Cities">
                            🌆 Iconic Cities
                        </option>

                        <option value="Surfing">
                            🏄 Surfing
                        </option>

                        <option value="Amazing Pools">
                            🏊 Amazing Pools
                        </option>

                        <option value="Beach">
                            🏖️ Beach
                        </option>

                        <option value="Cabins">
                            🏕️ Cabins
                        </option>

                        <option value="Mountains">
                            ⛰️ Mountains
                        </option>

                        <option value="Farms">
                            🌾 Farms
                        </option>

                        <option value="Lakefront">
                            🌊 Lakefront
                        </option>

                        <option value="Trending">
                            🔥 Trending
                        </option>

                    </select>

                </div>


                <div class="row">


                    <!-- PRICE -->

                    <div class="mb-3 col-md-4">

                        <label
                            for="price"
                            class="form-label"
                        >
                            Price / Night
                        </label>

                        <input
                            name="listing[price]"
                            id="price"
                            type="number"
                            min="0"
                            class="form-control"
                            placeholder="120"
                            required
                        >

                    </div>


                    <!-- COUNTRY -->

                    <div class="mb-3 col-md-8">

                        <label
                            for="country"
                            class="form-label"
                        >
                            Country
                        </label>

                        <input
                            name="listing[country]"
                            id="country"
                            type="text"
                            class="form-control"
                            placeholder="United States"
                            required
                        >

                    </div>

                </div>


                <!-- LOCATION -->

                <div class="mb-3">

                    <label
                        for="location"
                        class="form-label"
                    >
                        Location
                    </label>

                    <input
                        name="listing[location]"
                        id="location"
                        type="text"
                        class="form-control"
                        placeholder="New York City"
                        required
                    >

                </div>


                <button
                    type="submit"
                    class="btn btn-danger px-4 py-2"
                >
                    Create Listing
                </button>


            </form>

        </div>

    </div>

</div>